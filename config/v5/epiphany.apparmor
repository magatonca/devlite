# Candidate only: not published until confined browser rendering is validated.
abi <abi/4.0>,
include <tunables/global>
profile epiphany /usr/bin/epiphany{,-browser} flags=(attach_disconnected.path=/att/devlite-epiphany/) {
  include <abstractions/gnome>
  include <abstractions/nameservice>
  include <abstractions/dbus-session-strict>
  /etc/{os-release,lsb-release,machine-id,localtime} r,
  /etc/ssl/** r,
  /etc/glvnd/{,**} r,
  /dev/ r,
  /dev/dri/{renderD*,card*} rw,
  /proc/zoneinfo r,
  /att/devlite-epiphany/ r,
  owner /att/devlite-epiphany/proc/[0-9]*/{uid_map,gid_map,setgroups} rw,
  owner /att/devlite-epiphany/proc/[0-9]*/fd/{,**} r,
  owner /att/devlite-epiphany/proc/[0-9]*/mountinfo r,
  owner /att/devlite-epiphany/run/user/[0-9]*/browser.log rw,
  owner /att/devlite-epiphany/run/user/[0-9]*/webkitgtk/{bus-proxy-*,a11y-proxy-*} rw,
  owner /att/devlite-epiphany/run/user/[0-9]*/at-spi/bus_* rw,
  owner /att/devlite-epiphany/tmp/dbus-* rw,
  /proc/sys/kernel/{overflowuid,overflowgid} r,
  owner /proc/[0-9]*/fd/{,**} r,
  owner /proc/[0-9]*/{mountinfo,cgroup} r,
  owner @{HOME}/{.cache,.config,.local,.local/share}/ rw,
  owner @{HOME}/.cache/{mesa_shader_cache,gtk-4.0}{,/**} rwk,
  /usr/{share,lib,libexec}/** mr,
  /sys/{block,bus,class,dev,devices}{,/**} r,
  /var/cache/fontconfig/** r,
  /oldroot/var/cache/fontconfig{,/**} r,
  mount options=(rw,rbind) /oldroot/var/cache/fontconfig/ -> /newroot/var/cache/fontconfig/,
  owner @{HOME}/.config/epiphany{,/**} rwk,
  owner @{HOME}/.cache/{epiphany,webkitgtk}{,/**} rwk,
  owner @{HOME}/.local/share/epiphany{,/**} rwk,
  owner @{HOME}/Downloads{,/**} rwk,
  owner /run/user/[0-9]*/** rwk,
  dbus (send,receive) bus=session,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  signal (send,receive) peer=epiphany{,//*},
  signal (receive) peer=unconfined,
  deny @{HOME}/.ssh/** rwklmx,
  deny /etc/shadow r,
  # Explicit denies also apply during disposable complain-mode diagnostics.
  deny /{,oldroot/,newroot/,att/devlite-epiphany/}proc/{sys,irq,bus,fs}{,/**} wklmx,
  deny /{,oldroot/,newroot/,att/devlite-epiphany/}proc/sysrq-trigger rwklmx,
  deny /{oldroot,newroot}/etc/shadow r,
  deny /{oldroot,newroot}@{HOME}/.ssh/** rwklmx,
  userns,
  /usr/bin/epiphany{,-browser} ix,
  /usr/bin/bwrap ix,
  /usr/bin/xdg-dbus-proxy ix,
  /usr/lib/@{multiarch}/webkit{,2}gtk-{4.1,6.0}/WebKit{Web,Network,GPU}Process ix,
  userns,
  capability dac_override,
  capability sys_admin,
  capability setpcap,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability net_admin,
  capability sys_ptrace,
  ptrace (read,readby) peer=epiphany{,//*},
  /usr/bin/bwrap ix,
  /usr/bin/xdg-dbus-proxy ix,
  /usr/lib/@{multiarch}/webkit{,2}gtk-{4.1,6.0}/WebKit{Web,Network,GPU}Process ix,
  /proc/[0-9]*/{uid_map,gid_map,setgroups} rw,
  /proc/[0-9]*/ns/* r,
  /tmp/{newroot,oldroot}{,/**} rw,
  /newroot{,/**} rw,
  /oldroot/ r,
  owner /oldroot@{HOME}/.cache/ r,
  mount options=(rw,rbind) /oldroot@{HOME}/.cache/ -> /newroot@{HOME}/.cache/,
  /oldroot/{usr,etc,proc,dev,sys,run,tmp,lib,lib64}{,/**} r,
  owner /oldroot@{HOME}/.cache/{epiphany,webkitgtk}{,/**} rwk,
  owner /oldroot@{HOME}/.local/share/epiphany{,/**} rwk,
  / r,
  owner /proc/[0-9]*/{cmdline,statm} r,
  owner /bindfile[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] rw,
  mount options=(rw,rbind) /bindfile[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] -> /newroot/.flatpak-info,
  /.flatpak-info r,
  mount options=(rw,silent,rslave) -> /,
  mount options=(rw,silent,rprivate) -> /oldroot/,
  mount fstype=tmpfs -> /tmp/,
  mount options in (rw,ro,silent,bind,rbind,remount,nosuid,nodev,noexec) /oldroot/{usr,etc,proc,dev,sys,run,tmp,lib,lib64}{,/**} -> /newroot/**,
  mount options in (rw,ro,silent,bind,rbind,remount,nosuid,nodev,noexec) /oldroot@{HOME}/.cache/{epiphany,webkitgtk}{,/**} -> /newroot/**,
  mount options in (rw,ro,silent,bind,rbind,remount,nosuid,nodev,noexec) /oldroot@{HOME}/.local/share/epiphany{,/**} -> /newroot/**,
  mount options in (rw,ro,silent,bind,rbind,remount,nosuid,nodev,noexec) /newroot/** -> /newroot/**,
  mount options in (rw,ro,silent,bind,rbind,remount,nosuid,nodev,noexec) /oldroot/proc/ -> /proc/,
  mount fstype=tmpfs -> /newroot/**,
  mount fstype=proc -> /newroot/proc/,
  mount fstype=devpts -> /newroot/dev/pts/,
  mount options=(rw,silent,rbind) /tmp/newroot/ -> /tmp/newroot/,
  remount options in (ro,rw,bind,silent,nosuid,nodev,noexec,relatime) /newroot/**,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,
  pivot_root oldroot=/newroot/ /newroot/,
  umount /oldroot/,
  umount /,
}
