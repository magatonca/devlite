favorites=xfce4-web-browser.desktop,xfce4-mail-reader.desktop,xfce4-file-manager.desktop,libreoffice-writer.desktop,libreoffice-calc.desktop,snap-store_snap-store.desktop,xfce4-terminal-emulator.desktop,xfhelp4.desktop
load-hierarchy=true
launcher-show-name=true
launcher-show-description=false
item-icon-size=1
category-icon-size=0
hover-switch-category=false
favorites-in-recent=true
display-recent-default=false
position-search-alternate=true
command-switchuser=dm-tool switch-to-greeter
show-command-switchuser=false
command-settings=xfce4-settings-manager
show-command-settings=true
command-menueditor=menulibre
show-command-menueditor=true
command-lockscreen=xflock4
show-command-lockscreen=true
command-logout=xfce4-session-logout
show-command-logout=true
search-actions=5

[action0]
name=Man Pages
name[de]=Hauptseiten
name[es]=Páginas de manual
name[et]=Rakenduste abiteave
name[fr]=Man Pages
name[he]=עמודי הסבר
name[id]=Halaman Man
name[ja]=メインページ
name[ka]=დოკუმენტაციის გვერდები
name[kk]=Көмек (man) беттері
name[lt]=Vadovo puslapiai
name[oc]=Paginas principalas
name[pl]=Strony podręcznika
name[pt]=Páginas de manual
name[pt_BR]=Páginas de manuais
name[ru]=Страницы man
name[sv]=Huvudsidor
name[uk]=Сторінки Man
pattern=#
command=exo-open --launch TerminalEmulator man %s
regex=false

[action1]
name=Wikipedia
name[de]=Wikipedia
name[es]=Wikipedia
name[et]=Vikipeedia
name[fr]=Wikipedia
name[he]=ויקיפדיה
name[id]=Wikipedia
name[ja]=Wikipedia
name[ka]=Wikipedia - უფასო ენციკლოპედია
name[kk]=Википедия
name[lt]=Vikipedija
name[oc]=Wikipèdia
name[pl]=Wikipedia
name[pt]=Wikipédia
name[pt_BR]=Wikipédia
name[ru]=Википедия
name[sv]=Wikipedia
name[uk]=Вікіпедія
pattern=!w
command=exo-open --launch WebBrowser https://en.wikipedia.org/wiki/%u
regex=false

[action2]
name=Run in Terminal
name[de]=Im Terminal öffnen
name[es]=Ejecutar en un terminal
name[et]=Käivita terminalis
name[fr]=Exécuter dans un terminal
name[he]=הפעלה במסוף
name[id]=Jalankan dalam Terminal
name[ja]=ターミナルで実行する
name[ka]=ტერმინალში გაშვება
name[kk]=Терминалда орындау
name[lt]=Vykdyti terminale
name[oc]=Executar dins lo terminal
name[pl]=Uruchom w terminalu
name[pt]=Executar num Terminal
name[pt_BR]=Executar no terminal
name[ru]=Запустить в терминале
name[sv]=Kör i Terminal
name[uk]=Запустити у Терміналі
pattern=!
command=exo-open --launch TerminalEmulator %s
regex=false

[action3]
name=Open URI
name[de]=Adresse öffnen
name[es]=Abrir una ubicación
name[et]=Ava URI
name[fr]=Ouvrir l'URI
name[he]=פתיחת כתובת
name[id]=Buka URI
name[ja]=URI を開く
name[ka]=URI-ის გახსნა
name[kk]=URI ашу
name[lt]=Atverti URI
name[oc]=Dobrir l’URI
name[pl]=Otwórz adres URI
name[pt]=Abrir URI
name[pt_BR]=Abrir URI
name[ru]=Открыть URI
name[sv]=Öppna URI
name[uk]=Відкрити посилання
pattern=^(file|http|https):\\/\\/(.*)$
command=exo-open \\0
regex=true

[action4]
name=Search for files
name[de]=Nach Dateien suchen
name[es]=Buscar archivos
name[et]=Otsi faile
name[fr]=Chercher des fichiers
name[he]=חיפוש קבצים
name[id]=Cari berkas
name[ja]=ファイルを検索する
name[ka]=ფაილების ძებნა
name[kk]=Файлдарды іздеу
name[lt]=Ieškoti failų
name[oc]=Cercar de fichièrs
name[pl]=Szukaj plików
name[pt]=Procurar por ficheiros
name[pt_BR]=Pesquisar por arquivos
name[ru]=Поиск файлов
name[sv]=Sök efter filer
name[uk]=Шукати файли
pattern=-
command=catfish --path=~ --start %s
regex=false
button-title=Menu DevLite OS
button-icon=/usr/share/icons/hicolor/scalable/apps/devlite.svg
show-button-title=false
show-button-icon=true
