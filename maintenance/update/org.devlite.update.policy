<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <vendor>DevLite OS</vendor>
  <action id="org.devlite.update.install">
    <description>Instalar ou restaurar a atualização DevLite</description>
    <message>Autentique como administrador para alterar a versão da DevLite.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/devlite-update/updater.py</annotate>
  </action>
</policyconfig>
