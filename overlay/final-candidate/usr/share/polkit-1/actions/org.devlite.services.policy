<?xml version="1.0" encoding="UTF-8"?>
<policyconfig><vendor>DevLite OS</vendor><action id="org.devlite.services.control">
<description>Administrar serviços DevLite</description><description xml:lang="pt_BR">Administrar serviços DevLite</description>
<message>Autentique como administrador para controlar os serviços de desenvolvimento.</message>
<defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
<annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/devlite-service-control</annotate>
</action></policyconfig>
